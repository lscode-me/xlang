{"id": "B1-GRAM-0004", "ru": "Я вынужден уехать", "tr": ["Gideceğim", "Giderim", "Gitmek zorundayım", "Gitmeye mecburum"], "correct": 3, "explain_ru": "Вынужден — Zorundayım (-mek zorunda).", "tags": ["grammar", "modality", "obligation"], "source": "llm"}
