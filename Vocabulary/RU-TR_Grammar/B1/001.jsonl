{"id": "B1-GRAM-0004", "ru": "Я вынужден уехать", "tr": ["Gideceğim", "Gitmeye mecburum", "Gitmek zorundayım", "Giderim"], "correct": 3, "explain_ru": "Вынужден — Zorundayım (-mek zorunda).", "tags": ["grammar", "modality", "obligation"], "source": "llm"}
